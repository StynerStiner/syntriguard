{
  "version": 2,
  "builds": [
    {
      "src": "Admin/dist/**",
      "use": "@vercel/static"
    },
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/dashboard", "dest": "/Admin/dist/index.html" },
    { "src": "/login", "dest": "/Admin/dist/auth-login.html" },
    { "src": "/register", "dest": "/Admin/dist/auth-register.html" },
    { "src": "/guards", "dest": "/Admin/dist/tables-gridjs.html" },
    { "src": "/guard-roster", "dest": "/Admin/dist/tables-gridjs.html" },
    { "src": "/scheduler", "dest": "/Admin/dist/apps-calendar.html" },
    { "src": "/calendar", "dest": "/Admin/dist/apps-calendar.html" },
    { "src": "/map", "dest": "/Admin/dist/maps-leaflet.html" },
    { "src": "/deployment-map", "dest": "/Admin/dist/maps-leaflet.html" },
    { "src": "/clients", "dest": "/Admin/dist/clients-sites.html" },
    { "src": "/sites", "dest": "/Admin/dist/clients-sites.html" },
    { "src": "/incidents", "dest": "/Admin/dist/apps-invoices.html" },
    { "src": "/incident-log", "dest": "/Admin/dist/apps-invoices.html" },
    { "src": "/file-report", "dest": "/Admin/dist/apps-invoice-create.html" },
    { "src": "/messages", "dest": "/Admin/dist/apps-chat.html" },
    { "src": "/chat", "dest": "/Admin/dist/apps-chat.html" },
    { "src": "/ai", "dest": "/Admin/dist/ai-assistant.html" },
    { "src": "/ai-assistant", "dest": "/Admin/dist/ai-assistant.html" },
    { "src": "/settings", "dest": "/Admin/dist/settings.html" },
    { "src": "/performance", "dest": "/Admin/dist/guard-performance.html" },
    { "src": "/assets/(.*)", "dest": "/Admin/dist/assets/$1" },
    { "src": "/(.*\\.html)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.css)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.js)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.png)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.jpg)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.svg)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.ico)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.woff2?)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.eot)", "dest": "/Admin/dist/$1" },
    { "src": "/(.*\\.ttf)", "dest": "/Admin/dist/$1" },
    { "src": "/", "status": 302, "headers": { "Location": "/login" } }
  ]
}
